meta {
  name: Valid Reader Authentication
  type: http
  seq: 2
}

post {
  url: http://127.0.0.1:8000/v1/security/identity
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_id": "agent-reader",
    "credential": "reader-secret",
    "session_id": "bruno-session"
  }
}

assert {
  res.status: eq 200
  res.body.authenticated: eq true
  res.body.agent_id: eq "agent-reader"
  res.body.role: eq "reader"
}
