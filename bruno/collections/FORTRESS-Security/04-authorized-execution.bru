meta {
  name: Authorized Calculator Execution
  type: http
  seq: 4
}

post {
  url: http://127.0.0.1:8000/v1/security/execute
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_id": "agent-reader",
    "credential": "reader-secret",
    "session_id": "bruno-session",
    "tool_name": "calculator_read",
    "arguments": {
      "expression": "10 + 5"
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.decision: eq "allow"
  res.body.tool_name: eq "calculator_read"
  res.body.confirmation_required: eq false
}
