meta {
  name: Invalid Arguments
  type: http
  seq: 6
}

post {
  url: http://127.0.0.1:8000/v1/security/execute
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_id": "agent-reader",
    "credential": "reader-secret",
    "session_id": "bruno-session",
    "tool_name": "calculator_read",
    "arguments": {
      "expression": 123
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq false
  res.body.decision: eq "validation_error"
}
