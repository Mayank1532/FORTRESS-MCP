meta {
  name: High Risk Confirmation Boundary
  type: http
  seq: 7
}

post {
  url: http://127.0.0.1:8000/v1/security/execute
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_id": "agent-writer",
    "credential": "writer-secret",
    "session_id": "bruno-session",
    "tool_name": "update_record",
    "arguments": {
      "record_id": "demo",
      "value": "blocked"
    }
  }
}

assert {
  res.status: eq 200
  res.body.tool_name: eq "update_record"
  res.body.confirmation_required: eq true
}
